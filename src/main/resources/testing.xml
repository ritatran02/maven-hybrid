<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Data Table _ UI Automation Testing">
    <listeners>
        <listener class-name="commons.MethodListener"></listener>
        <listener class-name="jiraConfigs.JiraListener"></listener>
    </listeners>

    <parameter name="url" value="http://demo.nopcommerce/"></parameter>

    <test name ="Run on Firefox browser">
        <parameter name="browser" value="firefox"></parameter>
        <classes>
                <class name="com.nopcommerce.user.Level_11_Jira"></class>
        </classes>
    </test>

    <test name ="Run on Chrome browser">
        <parameter name="browser" value="chrome"></parameter>
        <classes>
                <class name="com.nopcommerce.user.Level_11_Jira"></class>
        </classes>
    </test>

    <test name ="Run on Edge browser">
        <parameter name="browser" value="edge"></parameter>
        <classes>
            <class name="com.nopcommerce.user.Level_11_Jira"></class>
        </classes>
    </test>

</suite>